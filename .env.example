# Required
DISCORD_TOKEN=<discord-bot-token>
# Deprecated alias still accepted during migration:
# CLIENT_SECRET=<discord-bot-token>

# Optional owner IDs for owner-only commands. If unset, owner-only commands are unrestricted for compatibility.
DISCORD_OWNER_IDS=123456789012345678

PORT=5000
REDIS_URL=redis://127.0.0.1:6379
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=gpt-4o-mini
GIPHY_KEY=<giphy-api-key>
MEME_USER=<imgflip-username>
MEME_PASS=<imgflip-password>
BRAVE_SEARCH_API_KEY=<brave-search-api-key>
IMG_KEY=<google-api-key>
IMG_CX=<google-custom-search-cx>
WEATHER=<openweathermap-api-key>
WOLFRAM_KEY=<wolfram-app-id>
TZ=America/Los_Angeles
