{
  "name": "discordbot",
  "version": "2.0.0",
  "description": "Bro, a modern TypeScript Discord bot.",
  "type": "module",
  "main": "dist/bot.js",
  "scripts": {
    "dev": "tsx src/bot.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/bot.js",
    "test": "vitest run",
    "test:e2e:offline": "NODE_ENV=test tsx src/e2e-offline.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mattnguyen1/DiscordBot.git"
  },
  "license": "ISC",
  "dependencies": {
    "chrono-node": "^2.8.4",
    "discord.js": "^14.19.3",
    "express": "^5.1.0",
    "openai": "^4.103.0",
    "redis": "^4.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.18",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
